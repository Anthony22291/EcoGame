      objectReference: {fileID: 735809786}
    - target: {fileID: 8083288220442271108, guid: 0980cc61cb4f9334b841439ba8b8be07, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8083288220442271108, guid: 0980cc61cb4f9334b841439ba8b8be07, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: "Hola viajero\u2026 un villano ha roto la Piedra de Poder"
      objectReference: {fileID: 0}
    - target: {fileID: 8083288220442271108, guid: 0980cc61cb4f9334b841439ba8b8be07, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: "Al destruirla, la piedra se dividi\xF3 en fragmentos. Debes encontrarlos
        y unirlos para restaurar el equilibrio del mundo"
      objectReference: {fileID: 0}
    - target: {fileID: 8083288220442271108, guid: 0980cc61cb4f9334b841439ba8b8be07, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "Ese ser\xE1 un viaje peligroso\u2026 que la suerte te acompa\xF1e"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 0980cc61cb4f9334b841439ba8b8be07, type: 3}
